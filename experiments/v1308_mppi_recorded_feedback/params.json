          "cost_weight": 5.0,
          "threshold_to_consider": 1.4
        },
        "GoalAngleCritic": {
          "enabled": true,
          "cost_power": 1,
          "cost_weight": 3.0,
          "threshold_to_consider": 0.5
        },
        "PreferForwardCritic": {
          "enabled": true,
          "cost_power": 1,
          "cost_weight": 5.0,
